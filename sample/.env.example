# ResidenceVertical Partner API — reference integration
#
# There is NO dotenv in this sample (zero dependencies). Either export these before starting,
# or prefix the command:  RV_API_KEY=rvp_test_… node server.js
#
# ---------------------------------------------------------------- partner backend (server.js)

# Where the Partner API lives. Default: the bundled mock. Point it at gamma once you have a key.
RV_API_BASE_URL=http://localhost:4010
# RV_API_BASE_URL=https://gamma.residencevertical.ro

# Your Partner API key — SERVER SIDE ONLY, never in a browser, an app or a public repo.
# Required as soon as RV_API_BASE_URL is not localhost. rvp_test_ = gamma, rvp_live_ = production.
RV_API_KEY=

# The webhook secret (whsec_…) ResidenceVertical gives you when your webhook is configured.
# Without it, incoming deliveries cannot be verified and are rejected with 401 (polling still works).
RV_WEBHOOK_SECRET=

# Port of this demo site.
PORT=4000

# How long the backend may serve a cached report status before asking ResidenceVertical again (ms).
RV_STATUS_CACHE_MS=3000

# ---------------------------------------------------------------- local mock (mock-rv-api.js)

MOCK_PORT=4010
# Seconds until a report becomes `generated` (the real thing takes ~4 minutes).
MOCK_REPORT_SECONDS=20
# The ACCOUNT webhook URL — the mock stands in for "the URL the RV team configures on your account".
MOCK_WEBHOOK_URL=http://localhost:4000/webhooks/residencevertical
MOCK_WEBHOOK_SECRET=whsec_local_mock_secret
# Retry schedule for failed deliveries (ms after the previous attempt). Default = production's
# 60000,300000,900000,3600000,10800000 — shorten it to watch retries without waiting an hour.
# MOCK_WEBHOOK_RETRY_DELAYS_MS=1000,2000,3000
# How long a report view link stays valid. The real platform default is 30 days (2592000 s),
# configurable per partner account. Set it to a few seconds to watch a link expire on demand:
#   MOCK_VIEW_LINK_TTL_SECONDS=10 node mock-rv-api.js
MOCK_VIEW_LINK_TTL_SECONDS=2592000
# The secret the mock signs view tokens with. Irrelevant against a real environment — there,
# ResidenceVertical mints the links and you just store the finished viewUrl.
MOCK_VIEW_TOKEN_SECRET=mock-view-token-secret
# MOCK-ONLY demo lever for CHECKOUT LINKS (guide §2.1): when set, every minted link lives this
# many seconds regardless of the request's expiresInHours (1..720 validation unchanged), so you
# can watch a link expire into the calm "Linkul de comandă nu mai este valid" state on demand:
#   MOCK_CHECKOUT_LINK_TTL_SECONDS=10 node mock-rv-api.js
# Unset (the default) honours each request's expiresInHours, like the real service.
# MOCK_CHECKOUT_LINK_TTL_SECONDS=10
# How many consecutive 502s the "Boom" hook answers before the create succeeds.
MOCK_BOOM_FAILURES=1
MOCK_DAILY_CAP=100
MOCK_COMMISSION_PCT=15
